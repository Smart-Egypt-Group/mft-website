  "shadow": {
    "card": "0 1px 2px rgba(13,27,62,.06), 0 4px 16px rgba(13,27,62,.08)",
    "pop": "0 12px 40px rgba(13,27,62,.18)",
    "glowCyan": "0 0 24px rgba(27,183,205,.45)"
  },
  "logo": {
    "lockup": "cube + «Standard Enterprise Governance» (CEO, 6 Nov 2026); variants: line, stack (3 lines), two (2 lines, the signature)",
    "signature": "SEG lockup (two) | hairline | full MFT logo (eagle + MODERN FINTECH). Never mirrored. Compact variant (cube + MFT, no name) only below the minimum.",
    "clearSpace": "2 modules on every side (≈ 0.18 of the cube's height in A)",
    "minSize": {
      "cubeDigitalPx": 24,
      "cubeDirectionBPx": 16,
      "printMm": 10,
      "nameCapPx": 10,
      "signatureCubeOn1080Px": 54
    },
    "lightBackground": "colour cube",
    "darkBackground": "on-dark cube or mono white"
  },
  "phi": {
    "$why": "CEO rule (7 Nov 2026): φ governs proportion, not decoration. Spacing grows by φ (the Fibonacci series), type grows by √φ so primary hierarchy levels sit two steps (= φ) apart, frames split 61.8/38.2, focal elements sit on golden points. Platform safe zones and readability win over φ.",
    "ratio": 1.6180339887,
    "space": [
      5,
      8,
      13,
      21,
      34,
      55,
      89,
      144,
      233,
      377,
      610
    ],
    "typeBase": 16,
    "typeStep": "sqrt(phi)",
    "split": [
      0.618,
      0.382
    ]
  }
}
