  "font": {
    "arabic": { "family": "Cairo", "file": "src/assets/fonts/cairo-arabic-var.woff2", "weights": "200–1000 (variable)", "licence": "SIL OFL 1.1" },
    "latin": { "family": "Inter", "file": "src/assets/fonts/inter-latin-var.woff2", "weights": "100–900 (variable)", "licence": "SIL OFL 1.1", "features": "tnum for figures in tables" },
    "stack": "\"Cairo\", \"Inter\", system-ui, sans-serif",
