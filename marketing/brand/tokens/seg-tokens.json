      "licence": "SIL OFL 1.1 (marketing/brand/fonts/OFL.txt)",
      "why": "measured closest to Cairo (type-metrics.json): body/x 0.969, alef/cap 1.027, stem 0.963; tabular figures by default (all digits 600 units); already the platform's PDF report face",
      "status": "used for the logo name; full switch after approval"
    },
    "stack": "\"Cairo\", \"IBM Plex Sans\", \"Inter\", system-ui, sans-serif",
    "stackLatin": "\"IBM Plex Sans\", \"Inter\", \"Cairo\", system-ui, sans-serif"
  },
  "type": {
    "$ratio": "φ system: UI steps by √φ (1.272) from 16, so every second step = φ; display (marketing) steps by φ from 26. Line heights snap to the 4 px grid; Arabic gets more leading than Latin.",
    "ui": {
      "base": 16,
      "ratio": 1.2720196,
      "steps": {
        "caption": -1,
        "body": 0,
        "bodyLg": 1,
        "h4": 2,
        "h3": 3,
        "h2": 4,
        "h1": 5
      }
    },
    "display": {
      "base": 26,
      "ratio": 1.6180339887,
      "steps": {
        "lead": 0,
        "headline": 1,
        "hero": 2,
        "display": 3,
        "mega": 4
      }
    },
    "leading": {
      "arabicBody": 1.7,
      "latinBody": 1.5,
      "arabicHeading": 1.3,
      "latinHeading": 1.15
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "black": 800
    },
    "tracking": {
      "overlineLatin": "0.14em",
      "arabic": "0 (never letter-space Arabic)"
    }
  },
  "space": {
    "0": 0,
    "1": 5,
    "2": 8,
    "3": 13,
    "4": 21,
    "5": 34,
    "6": 55,
    "7": 89,
    "8": 144,
    "9": 233
