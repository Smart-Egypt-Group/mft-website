  },
  "type": {
    "display": { "size": 96, "line": 1.05, "weight": 800 },
    "h1": { "size": 64, "line": 1.15, "weight": 800 },
    "h2": { "size": 44, "line": 1.2, "weight": 800 },
    "h3": { "size": 32, "line": 1.25, "weight": 700 },
    "bodyLg": { "size": 24, "line": 1.6, "weight": 500 },
    "body": { "size": 16, "line": 1.7, "weight": 400 },
    "caption": { "size": 13, "line": 1.5, "weight": 600 },
